# Ghostty config - optimized for git workflows

# Theme: Catppuccin Mocha (great for git diffs)
theme = Catppuccin Mocha

# Font
font-family = JetBrains Mono
font-size = 12

# Window
window-padding-x = 12
window-padding-y = 12

# Shell integration
shell-integration = detect
shell-integration-features = sudo,title

# Cursor
cursor-style = block
cursor-opacity = 1

# Splits/Panes - useful for side-by-side git diffs
keybind = ctrl+shift+right=new_split:right
keybind = ctrl+shift+down=new_split:down

# Tab navigation
keybind = ctrl+shift+n=new_tab
keybind = cmd+w=close_surface

# Common terminal shortcuts
keybind = cmd+d=new_window
keybind = cmd+k=clear_screen

# Colors - optimized for git output visibility
background = 1e1e2e
foreground = cdd6f4

# Selection color (for copy/paste)
selection-background = 45475a
selection-foreground = f5f5f5

# Copy on select (optional - good for quickly copying git hashes)
copy-on-select = true

# Scrollback
scrollback-limit = 10000
